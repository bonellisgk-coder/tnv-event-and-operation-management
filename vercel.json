{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --ignore-scripts && npm install --prefix frontend",
  "buildCommand": "npx prisma generate --schema=backend/prisma/schema.prisma && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "includeFiles": "backend/prisma/schema.prisma"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
