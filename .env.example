# Database configuration
DATABASE_URL="postgresql://postgres:postgres_pass_123@db:5432/tnv_db?schema=public"

# Backend configuration
PORT=4000
# Generate two distinct secrets of at least 32 characters. The application will not start without them.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
