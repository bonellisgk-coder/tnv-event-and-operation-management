FRONTEND_URL="http://localhost:5173"

# Email Configuration (Nodemailer SMTP)
# If left blank, emails will be printed to console and saved locally in "backend/sent_emails/" for local preview
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"TN Volunteer Platform" <no-reply@volunteer.tn.gov.in>'
